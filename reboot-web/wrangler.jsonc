// Cloudflare Workers(정적 자산) 배포 설정. 빌드 결과(out/)를 그대로 올린다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reboot",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "re-boot.kr", "custom_domain": true },
    { "pattern": "www.re-boot.kr", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
